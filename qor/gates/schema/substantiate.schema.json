{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qor-logic.mythologiq/schemas/gates/substantiate.schema.json",
  "title": "Substantiate Gate Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "phase",
    "ts",
    "session_id",
    "verdict",
    "merkle_seal"
  ],
  "properties": {
    "phase": {
      "const": "substantiate"
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "session_id": {
      "type": "string",
      "minLength": 3
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "reality_check": {
      "type": "object",
      "properties": {
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unplanned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "merkle_seal": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledger_entry": {
      "type": "integer",
      "minimum": 1
    },
    "ai_provenance": {
      "$ref": "_provenance.schema.json"
    },
    "spec_corpus_hash": {
      "type": "object",
      "description": "Phase 192 (GH #277): capability -> LF-normalized sha256 of the folded spec, recorded when the seal folded declared deltas.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "skill_corpus": {
      "type": "object",
      "description": "Which installed skill corpus produced this seal (Phase 217; GH #314). Disclosure, not enforcement: V1 records drift, GH #320 decides whether it can be enforced.",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope": {
          "type": "string"
        },
        "drift_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "boundary_scope": {
      "type": "string",
      "enum": [
        "structural",
        "structural+identity"
      ],
      "description": "Which detector set the boundary lint ran with (Phase 219; GH #309). CI cannot load the gitignored identity overlay, so an unqualified zero-findings result means less there than locally."
    },
    "intent_lock_state": {
      "type": "string",
      "enum": [
        "verified",
        "absent",
        "overridden"
      ],
      "description": "State of the /qor-implement Step 5.5 intent lock at seal (Phase 220; GH #324). Deliberately not a CI gate -- CI has no session and no lock, so the check is local by construction. Recorded here so a run of `absent` values is countable from the ledger without grepping shadow events."
    }
  }
}
