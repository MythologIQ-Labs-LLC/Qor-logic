{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythologiq.dev/qor/roadmap_event.schema.json",
  "title": "Qor Roadmap Event",
  "type": "object",
  "required": ["contract_version", "event_id", "roadmap_id", "seq", "ts", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"},
    "roadmap_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "seq": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "minLength": 1},
    "type": {"enum": ["roadmap_created", "node_added", "dependency_added", "node_resolved", "unresolved_space_added", "unresolved_space_retired", "planning_scope_added"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "roadmap_created"}}}, "then": {"properties": {"payload": {"type": "object", "required": ["objective"], "additionalProperties": false, "properties": {"objective": {"type": "object", "required": ["title", "success_conditions", "exclusions"], "additionalProperties": false, "properties": {"title": {"type": "string", "minLength": 1}, "success_conditions": {"type": "array", "items": {"type": "string"}}, "exclusions": {"type": "array", "items": {"type": "string"}}}}}}}}},
    {"if": {"properties": {"type": {"const": "node_added"}}}, "then": {"properties": {"payload": {"type": "object", "required": ["node"], "additionalProperties": false, "properties": {"node": {"type": "object", "required": ["id", "kind", "title", "resolver"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}, "kind": {"enum": ["fact", "decision", "prerequisite"]}, "title": {"type": "string", "minLength": 1}, "resolver": {"type": "string", "minLength": 1}, "authority_required": {"type": ["string", "null"]}}}}}}}},
    {"if": {"properties": {"type": {"const": "dependency_added"}}}, "then": {"properties": {"payload": {"type": "object", "required": ["predecessor_id", "dependent_id"], "additionalProperties": false, "properties": {"predecessor_id": {"type": "string", "minLength": 1}, "dependent_id": {"type": "string", "minLength": 1}}}}}},
    {"if": {"properties": {"type": {"const": "node_resolved"}}}, "then": {"properties": {"payload": {"type": "object", "required": ["node_id", "evidence_pointers", "rationale"], "additionalProperties": false, "properties": {"node_id": {"type": "string", "minLength": 1}, "evidence_pointers": {"type": "array", "items": {"type": "string"}}, "rationale": {"type": "string"}, "authority": {"type": ["string", "null"]}}}}}},
    {"if": {"properties": {"type": {"const": "unresolved_space_added"}}}, "then": {"properties": {"payload": {"type": "object", "required": ["space"], "additionalProperties": false, "properties": {"space": {"type": "object", "required": ["id", "title"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}, "title": {"type": "string", "minLength": 1}}}}}}}},
    {"if": {"properties": {"type": {"const": "unresolved_space_retired"}}}, "then": {"properties": {"payload": {"type": "object", "required": ["space_id", "reason"], "additionalProperties": false, "properties": {"space_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}}}},
    {"if": {"properties": {"type": {"const": "planning_scope_added"}}}, "then": {"properties": {"payload": {"type": "object", "required": ["scope"], "additionalProperties": false, "properties": {"scope": {"type": "object", "required": ["id", "title", "node_ids", "unresolved_space_ids"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}, "title": {"type": "string", "minLength": 1}, "node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "unresolved_space_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}}}}}
  ]
}
